<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  [MyBatis 기본 사원 매퍼 (emp.xml)]
  - namespace: 자바 코드(DAO)에서 이 매퍼를 식별하기 위한 고유 이름공간입니다.
    예: sqlSession.selectList("mapper.emp.selectEmp") 형태로 호출
-->
<mapper namespace="mapper.emp">

	<!--
	  [전체 사원 조회]
	  - id: namespace 내에서 이 SQL 문을 식별하는 고유 ID
	  - resultType: 조회된 결과 1행(Row)을 어떤 자바 객체에 담을지 지정
	    application.properties의 type-aliases-package 설정 덕분에
	    com.example.demo.dto.EmpDTO 대신 'empDTO'로 축약 사용 가능합니다.
	-->
	<select id="selectEmp" resultType="empDTO">
		select * from emp
	</select>

	<!--
	  [사원번호 단건 조회]
	  - parameterType: 외부에서 전달받는 파라미터의 데이터 타입 (int -> 정수형)
	  - #{_parameter}: 기본형/단일 파라미터(int, String 등)가 넘어왔을 때 MyBatis의 내장 예약어로 값을 바인딩합니다.
	    (파라미터 이름과 무관하게 넘어온 단일 값이 안전하게 치환됩니다.)
	-->
	<select id="selectEmpno" resultType="empDTO" parameterType="int">
		select * from emp
		where empno = #{_parameter}
	</select>

</mapper>


