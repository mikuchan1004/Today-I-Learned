<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ======================================================================
  [MyBatis 동적 쿼리(Dynamic SQL) 학습 매퍼 (dynamic.xml)]
  - 조건에 따라 SQL 문장이 유동적으로 변화하는 동적 SQL을 작성하는 파일입니다.
  - 검색 조건의 유무, 다중 조건 선택, 다중 값 IN 절 처리 등을 안전하고 깔끔하게 작성할 수 있습니다.
  ======================================================================
-->
<mapper namespace="mapper.emp.dynamic">

	<!-- 1. 기본 전체 조회 -->
	<select id="selectAllemp" resultType="empDTO">
		select * from emp
	</select>
	
	<!--
	  2. 사원 이름(ename) 부분 일치 검색 (LIKE 연산자)
	  - '||' : 문자열 연결 연산자 ('%' || #{ename} || '%')
	  - 예: ename이 "KING"이면 '%KING%'이 되어 앞뒤 어떤 글자가 와도 일치하는 데이터를 검색합니다.
	-->
	<select id="selectEnameemp" resultType="empDTO" parameterType="empDTO">
		select * from emp
		where ename like ('%' || #{ename} || '%')
	</select>
	
	<!--
	  3. 급여(sal) 이상 조건 검색과 CDATA 섹션
	  - <![CDATA[ ... ]]> : XML 파서에게 "이 안의 내용은 XML 태그가 아니니 순수 문자로 해석하라"고 알려줍니다.
	    (XML에서는 '<' 기호가 태그의 시작으로 인식되어 에러가 나므로, 반드시 CDATA로 감싸주어야 합니다.)
	-->
	<select id="selectSalemp" resultType="empDTO" parameterType="empDTO">
		select * from emp
		where sal <![CDATA[ >= ]]> #{sal}
	</select>

	<!--
	  4. <where> 태그와 <if> 태그의 조합 (다중 조건 검색)
	  - 과거의 'where 1=1' 방식을 대체하는 스마트한 MyBatis 태그입니다.
	  - <where> 태그의 핵심 장점:
	    1) 내부의 <if> 태그 중 하나라도 참이 되어 내용이 생성될 때만 WHERE 키워드를 자동으로 붙여줍니다.
	    2) 만약 첫 번째 조건 앞에 불필요하게 붙은 'AND'나 'OR'가 있다면 자동으로 제거해 줍니다.
	  - upper() 함수: 대소문자 구분 없이 검색하기 위해 양쪽을 모두 대문자로 변환 후 비교
	-->
	<select id="selectemp" resultType="empDTO" parameterType="empDTO">
		select * from emp
<!-- 		where 1=1 -->
		<where>
			<!-- 이름 검색어가 null이 아니고 빈 문자열("")도 아닐 때만 조건 추가 -->
			<if test="ename != null and ename != ''">
			    and upper(ename) like ('%' || upper(#{ename}) || '%')
			</if>
			<!-- 급여가 0보다 클 때만 이상(>=) 조건 추가 -->
			<if test="sal > 0">
			    and sal <![CDATA[ >= ]]> #{sal}
			</if>
		</where>
	</select>

	<!--
	  5. 검색 분류(type)에 따른 조건 분기 (<if> 태그 다중 사용)
	  - 검색창에서 드롭다운(select box)으로 조건 종류를 고르고 키워드를 입력했을 때의 처리
	  - type 값에 따라 각각 이름, 급여, 직무 조건절을 동적으로 조립합니다.
	-->
	<select id="select2emp" resultType="empDTO" parameterType="empDTO">
		select * from emp
		<where>
			<if test="type == 'ename'">
			    and upper(ename) like ('%' || upper(#{keyword}) || '%')
			</if>
			<if test="type == 'sal'">
			    and sal <![CDATA[ >= ]]> #{keyword}
			</if>
			<if test="type == 'job'">
			    and upper(job) like ('%' || upper(#{keyword}) || '%')
			</if>
		</where>
	</select>
	
	<!--
	  6. <choose>, <when>, <otherwise> 태그 (자바의 switch-case / if-else if-else)
	  - 여러 조건 중 단 하나만 만족시키고 싶을 때 사용합니다.
	  - <when> : 조건식(test)이 참인 첫 번째 블록만 실행
	  - <otherwise> : 위의 모든 <when> 조건이 거짓일 때 기본값으로 실행 (여기서는 관리자가 없는 사원 조회)
	-->
	<select id="choose" resultType="empDTO" parameterType="empDTO">
		select * from emp
		<where>
			
			<choose>
				<when test="type == 'ename'">
				    and upper(ename) like ('%' || upper(#{keyword}) || '%')
				</when>
				<when test="type == 'sal'">
				    and sal <![CDATA[ >= ]]> #{keyword}
				</when>
				<when test="type == 'job'">
				    and upper(job) like ('%' || upper(#{keyword}) || '%')
				</when>
				
				<!-- 기본값: 위 조건 중 아무것도 해당되지 않을 때 (예: 사장/대표처럼 mgr이 null인 사람) -->
				<otherwise>
					and mgr is null
				</otherwise>
			</choose>
			
		</where>
	</select>

	<!--
	  7. <foreach> 태그 (반복문 / IN 절 동적 생성)
	  - 자바의 List나 배열에 담긴 여러 개의 값을 SQL의 IN (값1, 값2, 값3...) 형태로 만들어줍니다.
	  - 속성 설명:
	    - collection="empnos" : DTO나 Map에 들어있는 List/배열 변수명
	    - item="item"         : 반복을 돌면서 꺼내온 각 원소를 가리킬 임시 변수명
	    - open="("            : 반복 시작 전에 맨 앞에 붙일 문자
	    - separator=","       : 반복되는 원소 사이에 붙일 구분자 (콤마)
	    - close=")"           : 반복이 끝난 후 맨 뒤에 닫아줄 문자
	  - 완성되는 SQL 예시: select * from emp where empno in ( 7369 , 7499 , 7521 )
	-->
	<select id="foreach" resultType="empDTO" parameterType="empDTO">
		select * from emp
<!-- 		where empno in (1,2,3,4) -->
		<where>
			empno in 
			<foreach 
				item="item" 
				collection="empnos"
				open="(" separator="," close=")">
				#{item}
			</foreach>
		</where>
	</select>

</mapper>











